# Copy this file to ".env" and fill in your values. Never commit .env!

# Google Gemini API key for the plant assistant (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: Gemini model (gemini-2.5-flash is no longer available to new keys)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: safety limits for the assistant (counted for all users together).
# Only raise them if https://aistudio.google.com/rate-limit shows your project allows more.
# CHAT_LIMIT_PER_DAY=20
# CHAT_LIMIT_PER_MINUTE=5

# Optional: a different MQTT broker (WebSocket address, port 9001)
# VITE_MQTT_URL=ws://192.168.1.207:9001
